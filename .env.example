# OLTP database (SQLite for dev, PostgreSQL for prod)
# SQLite: DB_URL=sqlite:///./data/pipeline.db
# PostgreSQL: DB_URL=postgresql://user:password@localhost:5432/job_pipeline
DB_URL=sqlite:///./data/pipeline.db

# Careerjet Partner API
# Register at https://www.careerjet.com/partners/api/
# Do NOT make live API calls until this is set
CAREERJET_API_KEY=
# Referer header required by the API — confirmed: https://www.careerjet.com.sa/
CAREERJET_REFERRER=https://www.careerjet.com.sa/

# Jooble Saudi Arabia search API (optional — only needed to re-pull Jooble data)
# Register at https://sa.jooble.org/api/about to receive a SA-specific key by email
# Current integration loads from data/raw/jooble_combined_2026-09-12.json
JOOBLE_SA_API_KEY=

# Techmap API via RapidAPI marketplace (optional — only needed to re-pull Techmap data)
# Endpoint: daily-international-job-postings; Basic (free) tier — 100 req/month
# Current integration loads from data/raw/techmap_live_raw.json
TECHMAP_API_KEY=

# Snowflake (OLAP destination — required for Phase 6)
# Obtain from your Snowflake account settings
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
